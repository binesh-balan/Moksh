<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Restore must resolve only from nuget.org. Without this file, restore uses whatever feeds the
    build machine has configured, so a private or hostile feed on a developer's machine can supply a
    package under a name this project expects to come from nuget.org.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

  <!--
    Package source mapping: every dependency is pinned to the single approved source, so a package
    can never be resolved from an unexpected feed even if one is added later.
  -->
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
